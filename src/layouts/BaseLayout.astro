---
import SEO from '../components/SEO.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  lang: 'zh-tw' | 'en';
  noindex?: boolean;
}

const { 
  title, 
  description, 
  keywords, 
  image, 
  lang,
  noindex = false 
} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />

    <!--SEO components - includes all meta tags -->
    <SEO 
      title={title}
      description={description}
      keywords={keywords}
      image={image}
      lang={lang}
      noindex={noindex}
    />
  </head>
  <body>
    <slot />
  </body>
</html>