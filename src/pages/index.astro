    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans TC', sans-serif;
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
      }

      .loading-container {
        text-align: center;
        animation: fadeIn 0.5s ease-in;
      }

      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
      }

      .logo-container {
        margin-bottom: 40px;
      }

      .logo {
        width: 200px;
        height: auto;
        max-width: 90%;
        margin: 0 auto;
        display: block;
      }

      .spinner {
        width: 60px;
        height: 60px;
        margin: 0 auto 32px;
        border: 4px solid rgba(255, 255, 255, 0.1);
        border-top-color: #f59e0b;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
      }

      @keyframes spin {
        to { transform: rotate(360deg); }
      }

      .loading-text {
        font-size: 20px;
        color: rgba(255, 255, 255, 0.9);
        margin-bottom: 12px;
        font-weight: 500;
      }

      .loading-subtext {
        font-size: 14px;
        color: rgba(255, 255, 255, 0.6);
      }

      .dots {
        display: inline-block;
      }

      .dots::after {
        content: '';
        animation: dots 1.5s steps(4, end) infinite;
      }

      @keyframes dots {
        0%, 20% { content: ''; }
        40% { content: '.'; }
        60% { content: '..'; }
        80%, 100% { content: '...'; }
      }

      @media (max-width: 640px) {
        .loading-text {
          font-size: 18px;
        }
        
        .loading-subtext {
          font-size: 12px;
        }
      }
    </style>
  </head>
  <body>
    <div class="loading-container">
      <div class="logo-container">
        <img src="/logo.png" alt="Oriental Express Travel" class="logo" />
      </div>

      <div class="spinner"></div>

      <div class="loading-text">
        <span class="dots">Loading</span>
      </div>
      <div class="loading-subtext">
        Detecting your language / 正在偵測語言
      </div>
      
      <!-- SEO 爬蟲連結 (For Googlebot only, normally users will be redirected before they click) -->
      <div style="margin-top: 20px; text-decoration: underline; opacity: 0.5; font-size: 14px;">
        <a href="/zh-tw/" style="color: white; margin-right: 15px;">繁體中文</a>
        <a href="/en/" style="color: white;">English</a>
      </div>
    </div>

    <script>
      (function() {
        // Check for saved language preference
        const savedLang = localStorage.getItem('preferredLanguage');
        
        if (savedLang && (savedLang === 'zh-tw' || savedLang === 'en')) {
          // Redirect to saved language
          window.location.replace('/' + savedLang + '/');
          return;
        }

        // Detect browser language
        const browserLang = navigator.language || navigator.userLanguage || '';
        const lang = browserLang.toLowerCase();
        
        // 判斷語言
        let targetLang = 'en'; // 預設英文
        
        if (lang.startsWith('zh-tw') || lang.startsWith('zh-hant')) {
          targetLang = 'zh-tw';
        } else if (lang.startsWith('zh-cn') || lang.startsWith('zh-hans')) {
          targetLang = 'zh-cn'; 
        } else if (lang.startsWith('zh')) {
          targetLang = 'zh-tw';
        } else if (lang.startsWith('es')) {
          targetLang = 'es'; 
        }
        
        // Currently only support 'zh-tw' and 'en'
        if (targetLang !== 'zh-tw' && targetLang !== 'en') {
          targetLang = 'en';
        }
        
        // Save preference
        localStorage.setItem('preferredLanguage', targetLang);
        
        setTimeout(function() {
          window.location.replace('/' + targetLang + '/');
        }, 1000);
      })();
    </script>
  </body>
</html>