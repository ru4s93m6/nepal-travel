---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navigation from '../../../components/Navigation.astro';
import TourDetail from '../../../components/TourDetail.astro';
import Contact from '../../../components/Contact.astro';
import { ebcTour } from '../../../data/tours/ebc';
import { langtangTour } from '../../../data/tours/langtang';
import { chitwanTour } from '../../../data/tours/chitwan';
import { lumbiniTour } from '../../../data/tours/lumbini';
import { abcTour } from '../../../data/tours/abc';
import { poonHillTour } from '../../../data/tours/poon_hill';
import { manasluTour } from '../../../data/tours/manaslu';
import { kathmanduValleyTour } from '../../../data/tours/kathmandu_valley';
import { bhutanTour } from '../../../data/tours/bhutan';
import { actTour } from '../../../data/tours/act';

export function getStaticPaths() {
  const tours = [ebcTour, langtangTour, chitwanTour, lumbiniTour, abcTour, actTour, poonHillTour, manasluTour, kathmanduValleyTour, bhutanTour];
  return tours.map(tour => ({
    params: { id: tour.id },
    props: { tour },
  }));
}

const { id } = Astro.params;
const { tour } = Astro.props;
const lang = 'zh-tw';
const content = tour.locales[lang as 'zh-tw' | 'en'];

const seoTitle = `${content.title} | Oriental Express Travel`;
const seoDescription = content.overview.substring(0, 160) + '...';
const seoKeywords = `${content.title}, 尼泊爾旅遊, Nepal Trekking, 尼泊爾當地旅行社, ${id.toUpperCase()}`;

---
<BaseLayout 
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  lang={lang}
>
  <TourDetail tour={tour} />
  <Contact lang={lang} />
</BaseLayout>
