---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navigation from '../../../components/Navigation.astro';
import TourDetail from '../../../components/TourDetail.astro';
import Contact from '../../../components/Contact.astro';
import { ebcTour } from '../../../data/tours/ebc';
import { langtangTour } from '../../../data/tours/langtang';
import { chitwanTour } from '../../../data/tours/chitwan';
import { lumbiniTour } from '../../../data/tours/lumbini';
import { abcTour } from '../../../data/tours/abc';
import { poonHillTour } from '../../../data/tours/poon_hill';
import { manasluTour } from '../../../data/tours/manaslu';
import { kathmanduValleyTour } from '../../../data/tours/kathmandu_valley';
import { bhutanTour } from '../../../data/tours/bhutan';
import { actTour } from '../../../data/tours/act';
import { gokyoTour } from '../../../data/tours/gokyo';
import { pokharaTour } from '../../../data/tours/pokhara';

export function getStaticPaths() {
  const tours = [ebcTour, langtangTour, chitwanTour, lumbiniTour, abcTour, actTour, poonHillTour, manasluTour, kathmanduValleyTour, bhutanTour, gokyoTour, pokharaTour];
  return tours.map(tour => ({
    params: { id: tour.id },
    props: { tour },
  }));
}

const { id } = Astro.params;
const { tour } = Astro.props;
const lang = 'zh-tw';
const content = tour.locales[lang as 'zh-tw' | 'en'];

const isNepalTour = tour.id !== 'bhutan';
const cleanTitle = content.title.replace(/\n/g, ' ');

const seoTitle = isNepalTour
  ? `尼泊爾${cleanTitle} ${tour.durationDays}天行程 | Oriental Express Travel`
  : `${cleanTitle} | Oriental Express Travel`;

const descSuffix = isNepalTour
  ? '，尼泊爾在地旅行社帶隊，彈性客製包團，含嚮導住宿交通。'
  : '，含簽證、機票、住宿全包，彈性規劃。';
const cleanSubtitle = content.subtitle.replace(/[。！？，、\.!\?]$/, '');
const descRaw = cleanSubtitle + descSuffix;
const seoDescription = descRaw.length > 160 ? descRaw.substring(0, 158) + '…' : descRaw;

const seoKeywords = isNepalTour
  ? `尼泊爾${cleanTitle}, ${content.title.split('\n')[0]}, 尼泊爾旅遊, 尼泊爾健行, 尼泊爾旅行社, 尼泊爾當地旅行社, ${id.toUpperCase()}`
  : `${cleanTitle}, 不丹旅遊, 不丹行程, 不丹旅行社, Oriental Express Travel`;

const breadcrumbs = [
  { name: '首頁', item: 'https://oriental-express-travel.com/zh-tw/' },
  { name: '行程介紹', item: 'https://oriental-express-travel.com/zh-tw/#tours' },
  { name: content.title.replace('\n', ' '), item: `https://oriental-express-travel.com/zh-tw/tours/${id}/` },
];

// Generate Schema Markup for TouristTrip
const schemaData = {
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": content.title,
  "description": content.overview,
  "provider": {
    "@type": "TravelAgency",
    "name": "Oriental Express Travel",
    "url": "https://oriental-express-travel.com"
  },
  "itinerary": {
    "@type": "ItemList",
    "itemListElement": content.itinerary.map((day, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "TouristAttraction",
        "name": `第 ${day.day} 天: ${day.title}`,
        "description": day.description
      }
    }))
  }
};
---
<BaseLayout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  lang={lang}
  breadcrumbs={breadcrumbs}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schemaData)} />
  <Navigation lang={lang} />
  <TourDetail tour={tour} />
  <Contact lang={lang} />
</BaseLayout>
