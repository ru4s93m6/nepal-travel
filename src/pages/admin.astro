<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin — Order Management | Oriental Express Travel</title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #f1f5f9;
      color: #1e293b;
      height: 100vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    /* ── Header ── */
    .admin-header {
      background: #1A2B49;
      color: white;
      padding: 0 24px;
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-shrink: 0;
      box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }
    .admin-header h1 {
      font-size: 18px;
      font-weight: 600;
      letter-spacing: 0.02em;
    }
    .header-actions { display: flex; gap: 10px; align-items: center; }
    .btn-add {
      background: #D4AF37;
      color: #1A2B49;
      border: none;
      padding: 8px 18px;
      border-radius: 7px;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      transition: background 0.15s;
    }
    .btn-add:hover { background: #b8962e; }
    .btn-logout {
      background: transparent;
      color: rgba(255,255,255,0.6);
      border: 1px solid rgba(255,255,255,0.2);
      padding: 7px 14px;
      border-radius: 7px;
      font-size: 13px;
      cursor: pointer;
      transition: all 0.15s;
    }
    .btn-logout:hover { color: white; border-color: rgba(255,255,255,0.5); }

    /* ── Main Layout ── */
    .admin-main {
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 16px;
      padding: 16px;
      flex: 1;
      overflow: hidden;
    }

    /* ── Calendar ── */
    .calendar-section {
      background: white;
      border-radius: 12px;
      padding: 16px;
      overflow: auto;
      box-shadow: 0 1px 4px rgba(0,0,0,0.08);
    }
    #calendar { height: 100%; min-height: 500px; }
    .fc .fc-toolbar-title { font-size: 16px; font-weight: 600; }
    .fc .fc-button { background: #1A2B49 !important; border-color: #1A2B49 !important; font-size: 13px !important; }
    .fc .fc-button:hover { background: #243d65 !important; }
    .fc .fc-daygrid-event { border-radius: 4px; font-size: 11px; padding: 1px 4px; cursor: pointer; }
    .fc .fc-day-today { background: rgba(212, 175, 55, 0.08) !important; }

    /* ── Sidebar ── */
    .bookings-sidebar {
      display: flex;
      flex-direction: column;
      gap: 0;
      overflow-y: auto;
      border-radius: 12px;
    }
    .sidebar-header {
      background: white;
      border-radius: 12px 12px 0 0;
      padding: 14px 16px;
      font-size: 13px;
      font-weight: 600;
      color: #64748b;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      border-bottom: 1px solid #f1f5f9;
      flex-shrink: 0;
      position: sticky;
      top: 0;
      z-index: 1;
    }
    #sidebar-month { color: #1A2B49; }

    .booking-card {
      background: white;
      padding: 14px 16px;
      border-left: 4px solid transparent;
      border-bottom: 1px solid #f1f5f9;
      cursor: pointer;
      transition: background 0.1s;
    }
    .booking-card:last-child { border-radius: 0 0 12px 12px; border-bottom: none; }
    .booking-card:hover { background: #f8fafc; }
    .booking-card .card-name { font-weight: 600; font-size: 14px; margin-bottom: 4px; }
    .booking-card .card-dates { font-size: 12px; color: #64748b; margin-bottom: 6px; }
    .booking-card .card-footer { display: flex; justify-content: space-between; align-items: center; }
    .status-badge {
      font-size: 11px;
      font-weight: 600;
      padding: 2px 8px;
      border-radius: 999px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .status-paid { background: #dcfce7; color: #15803d; }
    .status-unpaid { background: #fee2e2; color: #b91c1c; }
    .status-partially_paid { background: #fef9c3; color: #92400e; }
    .card-whatsapp {
      font-size: 12px;
      color: #25D366;
      text-decoration: none;
      font-weight: 500;
    }
    .card-whatsapp:hover { text-decoration: underline; }

    .no-bookings {
      background: white;
      border-radius: 0 0 12px 12px;
      padding: 32px 16px;
      text-align: center;
      color: #94a3b8;
