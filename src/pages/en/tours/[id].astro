---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navigation from '../../../components/Navigation.astro';
import TourDetail from '../../../components/TourDetail.astro';
import Contact from '../../../components/Contact.astro';
import { ebcTour } from '../../../data/tours/ebc';
import { langtangTour } from '../../../data/tours/langtang';
import { chitwanTour } from '../../../data/tours/chitwan';
import { lumbiniTour } from '../../../data/tours/lumbini';
import { abcTour } from '../../../data/tours/abc';
import { poonHillTour } from '../../../data/tours/poon_hill';
import { manasluTour } from '../../../data/tours/manaslu';
import { kathmanduValleyTour } from '../../../data/tours/kathmandu_valley';
import { bhutanTour } from '../../../data/tours/bhutan';
import { actTour } from '../../../data/tours/act';
import { gokyoTour } from '../../../data/tours/gokyo';

export function getStaticPaths() {
  const tours = [ebcTour, langtangTour, chitwanTour, lumbiniTour, abcTour, actTour, poonHillTour, manasluTour, kathmanduValleyTour, bhutanTour, gokyoTour];
  return tours.map(tour => ({
    params: { id: tour.id },
    props: { tour },
  }));
}

const { id } = Astro.params;
const { tour } = Astro.props;
const lang = 'en';
const content = tour.locales[lang as 'zh-tw' | 'en'];

const seoTitle = `${content.title} | Oriental Express Travel`;
const seoDescription = content.overview.substring(0, 150) + '...';
const seoKeywords = `${content.title}, Nepal Trekking, Nepal local travel agency, ${id.toUpperCase()}`;

// Generate Schema Markup for TouristTrip
const schemaData = {
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": content.title,
  "description": content.overview,
  "provider": {
    "@type": "TravelAgency",
    "name": "Oriental Express Travel",
    "url": "https://oriental-express-travel.com"
  },
  "itinerary": {
    "@type": "ItemList",
    "itemListElement": content.itinerary.map((day, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "TouristAttraction",
        "name": `Day ${day.day}: ${day.title}`,
        "description": day.description
      }
    }))
  }
};
---
<BaseLayout 
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  lang={lang}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schemaData)} />
  <TourDetail tour={tour} />
  <Contact lang={lang} />
</BaseLayout>
