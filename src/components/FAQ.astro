---
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: 'zh-tw' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const faqs = t('faq');
---

<section id="faq" class="py-20 px-6 bg-brand-cream">
  <div class="max-w-4xl mx-auto">
    <!-- Title Section -->
    <div class="text-center mb-16">
      <div class="inline-block mb-6">
        <div class="h-1 w-20 bg-gradient-to-r from-brand-gold to-yellow-600 mx-auto"></div>
      </div>
      <h2 class="text-4xl md:text-5xl font-serif font-bold text-brand-blue mb-4">
        {lang === 'zh-tw' ? '常見問題' : 'Frequently Asked Questions'}
      </h2>
    </div>

    <!-- FAQ Accordion -->
    <div class="space-y-4">
      {faqs.map((faq, index) => (
        <details class="group bg-white rounded-xl border border-stone-200 overflow-hidden hover:shadow-lg transition-all duration-300">
          <summary class="cursor-pointer p-6 flex items-center justify-between font-semibold text-lg text-brand-blue hover:text-brand-gold transition-colors list-none">
            <span class="flex items-start gap-4 flex-1">
              <span class="w-8 h-8 bg-brand-gold rounded-lg flex items-center justify-center flex-shrink-0 text-white text-sm font-bold">
                {(index + 1).toString().padStart(2, '0')}
              </span>
              <span class="pt-0.5">{faq.question}</span>
            </span>
            <svg 
              class="w-6 h-6 text-brand-gold flex-shrink-0 ml-4 transition-transform duration-300 group-open:rotate-180" 
              fill="none" 
              stroke="currentColor" 
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </summary>
          <div class="px-6 pb-6 pt-2">
            <div class="pl-12 text-brand-blue/80 leading-relaxed border-l-4 border-brand-gold/30 pl-6 ml-8">
              {faq.answer}
            </div>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  /* Smooth animation for accordion */
  details[open] summary {
    margin-bottom: 0.5rem;
  }
  
  /* Hide default marker */
  summary::-webkit-details-marker {
    display: none;
  }
</style>