---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { nepalZones } from "../data/nepal-map-data";
import { getImage } from "astro:assets";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Projection Constants (derived from MapsVG metadata)
const MAP_WIDTH = 800.36517;
const MAP_HEIGHT = 454.28867;
const MIN_LON = 80.051163;
const MAX_LON = 88.193593;
const MIN_LAT = 26.348125;
const MAX_LAT = 30.431317;

const LON_SPAN = MAX_LON - MIN_LON;
const LAT_SPAN = MAX_LAT - MIN_LAT;

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/*.{webp,png,jpg,jpeg}');

// Helper to project Lat/Lon to SVG Pixels
function project(lat: number, lng: number) {
  const x = ((lng - MIN_LON) / LON_SPAN) * MAP_WIDTH;
  const y = ((MAX_LAT - lat) / LAT_SPAN) * MAP_HEIGHT;
  return { x, y };
}

// Destination information with SEO-friendly image attributes and Lat/Lon
const rawDestinations = [
  // Kathmandu Valley (Central) - Spread out for UX
  { id: 'kathmandu_durbar', image: '/kathmandu.webp', lat: 27.6950, lng: 85.2900, region: 'kathmandu', category: 'culture' }, // Moved SE
  { id: 'patan_durbar', image: '/patan.webp', lat: 27.6727, lng: 85.3253, region: 'kathmandu', category: 'culture' },
  { id: 'boudhanath', image: '/boudhanath.webp', lat: 27.7250, lng: 85.3750, region: 'kathmandu', category: 'culture' }, // Moved NE
  { id: 'pashupatinath', image: '/pashupatinath.webp', lat: 27.7120, lng: 85.3550, region: 'kathmandu', category: 'culture' }, // Slight East
  { id: 'swayambhunath', image: '/swayambhunath.webp', lat: 27.7149, lng: 85.2903, region: 'kathmandu', category: 'culture' },
  { id: 'shivapuri', image: '/shivapuri.webp', lat: 27.8033, lng: 85.3856, region: 'kathmandu', category: 'nature' },
  { id: 'thamel', image: '/thamel.webp', lat: 27.7250, lng: 85.3050, region: 'kathmandu', category: 'leisure' }, // Moved NW
  { id: 'bhaktapur', image: '/bhaktapur.webp', lat: 27.6710, lng: 85.4298, region: 'kathmandu', category: 'culture' }, // Keep
  { id: 'nagarkot', image: '/nagarkot.webp', lat: 27.7174, lng: 85.5046, region: 'kathmandu', category: 'leisure' }, // Keep
  
  // Pokhara & Annapurna (West) - Spread out for UX
  { id: 'phewa', image: '/pokhara.webp', lat: 28.2000, lng: 83.9500, region: 'pokhara', category: 'leisure' }, // Slight South
  { id: 'sarangkot', image: '/sarangkot.webp', lat: 28.2550, lng: 83.9350, region: 'pokhara', category: 'leisure' }, // Moved NW
  { id: 'machhapuchhre', image: '/machhapuchhre.webp', lat: 28.5300, lng: 83.9493, region: 'pokhara', category: 'nature' }, // Keep
  { id: 'abc', image: '/annapurna.webp', lat: 28.5800, lng: 83.8500, region: 'pokhara', category: 'trekking' }, // Moved NW
  { id: 'poon_hill', image: '/poon_hill.webp', lat: 28.3800, lng: 83.6500, region: 'pokhara', category: 'trekking' }, // Moved SW
  { id: 'mardi_himal', image: '/mardi_himal.webp', lat: 28.4600, lng: 84.0000, region: 'pokhara', category: 'trekking' }, // Moved East
  { id: 'mustang', image: '/mustang.webp', lat: 29.1866, lng: 83.9515, region: 'pokhara', category: 'trekking' }, // Keep

  // Everest (East)
  { id: 'ebc', image: '/everest.webp', lat: 28.0026, lng: 86.8528, region: 'everest', category: 'trekking' },

  // Others
  { id: 'chitwan', image: '/chitwan.webp', lat: 27.5291, lng: 84.3542, region: 'others', category: 'nature' },
  { id: 'lumbini', image: '/lumbini.webp', lat: 27.4840, lng: 83.2760, region: 'others', category: 'culture' }, 
  { id: 'langtang', image: '/langtang.webp', lat: 28.2128, lng: 85.6028, region: 'others', category: 'trekking' },
  { id: 'manaslu', image: '/manaslu.webp', lat: 28.5500, lng: 84.5600, region: 'others', category: 'trekking' },
];

const destinations = await Promise.all(rawDestinations.map(async (dest) => {
  const imagePath = `/src/assets${dest.image}`;
  let mobileSrc = dest.image;
  let desktopSrc = dest.image;
  
  if (images[imagePath]) {
    const imgModule = await images[imagePath]();
    const mobileImg = await getImage({ src: imgModule.default, width: 200, format: 'webp', quality: 80 });
    const desktopImg = await getImage({ src: imgModule.default, width: 800, format: 'webp', quality: 80 });
    mobileSrc = mobileImg.src;
    desktopSrc = desktopImg.src;
  }
  
  return { ...dest, mobileSrc, desktopSrc };
}));

const regions = [
  { id: 'kathmandu', label: 'Kathmandu Valley' },
  { id: 'pokhara', label: 'Pokhara & Annapurna' },
  { id: 'everest', label: 'Everest Region' },
  { id: 'others', label: 'Other Highlights' },
];

const categories = [
  'trekking',
  'culture',
  'nature',
  'leisure'
];
---

<section id="tours" class="py-20 bg-brand-cream overflow-hidden">
  <div class="container mx-auto px-6">
    <!-- Title Section -->
    <div class="text-center mb-12">
      <h2 class="text-4xl md:text-5xl font-serif font-bold text-brand-blue mb-4">
        {t('itinerary.title')}
      </h2>
      <p class="text-xl text-brand-blue/80 mb-6">
        {t('itinerary.subtitle')}
      </p>
      <p class="text-brand-blue/70 max-w-3xl mx-auto leading-relaxed">
        {t('itinerary.description')}
      </p>
    </div>

    <!-- Desktop Map Filter Tabs -->
    <div class="hidden md:flex justify-center mb-8">
      <div class="inline-flex flex-wrap justify-center gap-2 bg-stone-100 rounded-2xl p-1.5 shadow-inner border border-stone-200" id="map-filters">
        <button class="filter-btn active px-6 py-2 rounded-xl text-sm font-medium transition-all text-white bg-brand-blue shadow-md" data-category="all">
          {t('itinerary.filter.all' as any) || 'All Highlights'}
        </button>
        {categories.map(cat => (
          <button class="filter-btn px-6 py-2 rounded-xl text-sm font-medium transition-all text-stone-600 hover:text-brand-blue hover:bg-white" data-category={cat}>
            {t(`itinerary.filter.${cat}` as any)}
          </button>
        ))}
      </div>
    </div>

    <!-- Desktop View: Interactive Zoomed Map -->
    <div id="desktop-map-view" class="hidden md:block relative transition-opacity duration-300">
       <div class="relative w-full max-w-7xl mx-auto aspect-[2/1] bg-brand-cream/50 rounded-3xl border border-brand-gold/20 shadow-xl overflow-hidden backdrop-blur-sm p-4">
        <!-- Zoomed ViewBox: showing only the country, larger -->
        <svg viewBox="0 0 800.36517 454.28867" class="w-full h-full" id="nepal-map-itinerary">
          
          <!-- Background Border Sealer (Thicker stroke to fill gaps) -->
          <g class="pointer-events-none">
            {nepalZones.map((zone) => (
              <path
                d={zone.d}
                fill="none"
                stroke="#D4AF37"
                stroke-width="3"
                stroke-linejoin="round"
                stroke-linecap="round"
                class="opacity-100"
              />
            ))}
          </g>

          <!-- Detailed Zones (Interactive Top Layer) -->
          <g class="drop-shadow-sm">
            {nepalZones.map((zone) => (
              <path
                id={zone.id}
                d={zone.d}
                fill="#F5F5F0"
                stroke="#D4AF37"
                stroke-width="1"
                stroke-linejoin="round"
                stroke-linecap="round"
                class="hover:fill-brand-gold/10 transition-colors duration-300"
              >
                <title>{zone.name}</title>
              </path>
            ))}
          </g>

          <!-- Dynamic Location Markers -->
          {destinations.map((dest) => {
            const { x, y } = project(dest.lat, dest.lng);
            return (
            <g class="map-node cursor-pointer group" 
               data-id={dest.id} 
               data-category={dest.category}
               transform={`translate(${x}, ${y})`}>
               
               <!-- Invisible Hit Area (Larger) for stable hover -->
               <circle r="12" fill="transparent" />

               <!-- Visible Dot -->
               <circle r="3" fill="#1A2B49" class="transition-all duration-300 group-hover:scale-150 group-hover:fill-brand-gold shadow-lg relative z-20 pointer-events-none" />
               <!-- Ping Animation: Only active on hover -->
               <circle r="8" stroke="#D4AF37" stroke-width="0.5" fill="none" class="hidden group-hover:block group-hover:animate-ping opacity-60 pointer-events-none" />
            </g>
            );
          })}
          
        </svg>
        <div class="absolute bottom-4 left-0 right-0 text-center pointer-events-none">
          <p class="text-brand-blue/60 text-sm animate-bounce">{t('itinerary.clickHint') || '點擊地點查看詳情'}</p>
        </div>
        
        <!-- Zoom Controls -->
        <div class="absolute bottom-6 right-6 flex flex-col gap-2 z-30">
            <button id="recenter-map" class="w-10 h-10 bg-white/90 hover:bg-brand-gold text-brand-blue hover:text-white rounded-full shadow-lg flex items-center justify-center transition-all duration-300 border border-brand-gold/30 hover:scale-110" aria-label="Recenter Map" title="Recenter">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v2m0 12v2m8-8h-2M6 12H4m12 0a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
            </button>
            <button id="zoom-in" class="w-10 h-10 bg-white/90 hover:bg-brand-gold text-brand-blue hover:text-white rounded-full shadow-lg flex items-center justify-center transition-all duration-300 border border-brand-gold/30 hover:scale-110" aria-label="Zoom In">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            </button>
            <button id="zoom-out" class="w-10 h-10 bg-white/90 hover:bg-brand-gold text-brand-blue hover:text-white rounded-full shadow-lg flex items-center justify-center transition-all duration-300 border border-brand-gold/30 hover:scale-110" aria-label="Zoom Out">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"/></svg>
            </button>
        </div>
      </div>
      
      <!-- Tooltip (Fixed Position) -->
      <div id="map-tooltip" class="fixed top-0 left-0 bg-brand-blue/90 text-white text-xs font-bold px-3 py-1.5 rounded-md shadow-2xl z-50 pointer-events-none backdrop-blur-sm border border-white/10 opacity-0 transition-opacity duration-150" style="will-change: top, left;">
      </div>
    </div>

    <!-- Mobile View: Region List (Accordion style) -->
    <div id="mobile-list-view" class="md:hidden space-y-6">
      {regions.map((region) => (
        <div class="bg-white rounded-xl shadow-md overflow-hidden border border-brand-gold/10">
          <div class="bg-brand-blue/5 p-4 border-b border-brand-gold/10 flex justify-between items-center">
            <h3 class="font-serif text-xl font-bold text-brand-blue">
               {t(`itinerary.regions.${region.id}` as any)}
            </h3>
            <span class="text-brand-gold text-sm font-bold">
               {destinations.filter(d => d.region === region.id).length} {t('itinerary.destinationsCount')}
            </span>
          </div>
          <div class="divide-y divide-gray-100">
            {destinations.filter(d => d.region === region.id).map(dest => (
               <div class="p-4 hover:bg-brand-cream/30 transition-colors cursor-pointer mobile-dest-item" 
                    data-id={dest.id}>
                  <div class="flex gap-4">
                    <div class="w-20 h-20 flex-shrink-0 rounded-lg overflow-hidden bg-gray-200">
                       <img src={dest.mobileSrc} alt={t(`itinerary.destinations.${dest.id}.name`)} class="w-full h-full object-cover" loading="lazy" />
                    </div>
                    <div>
                       <h4 class="font-bold text-brand-blue text-lg">{t(`itinerary.destinations.${dest.id}.name`)}</h4>
                       <p class="text-gray-500 text-sm line-clamp-2 mt-1">{t(`itinerary.destinations.${dest.id}.description`)}</p>
                       <span class="text-brand-gold text-xs font-bold mt-2 inline-block">{t('button.learnMore')} &rarr;</span>
                    </div>
                  </div>
               </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- 詳細視圖 - 預設隱藏 -->
    <div id="detail-view" class="hidden max-w-7xl mx-auto transition-opacity duration-300">
      <div class="bg-white rounded-lg shadow-xl overflow-hidden border border-stone-200">
        <!-- 返回按鈕 -->
        <div class="p-6 border-b border-stone-200">
          <button 
            id="back-button"
            class="cursor-pointer flex items-center gap-2 text-amber-700 hover:text-amber-800 transition font-medium"
            aria-label={t('itinerary.button.close')}
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            {t('itinerary.button.close')}
          </button>
        </div>

        <!-- 詳細內容 - 固定高度 -->
        <div class="flex flex-col lg:flex-row lg:h-[600px]">
          <!-- 圖片區域 - 固定高度,底部對齊 -->
          <div class="lg:w-1/2 h-64 lg:h-full overflow-hidden bg-stone-100">
            <img 
              id="detail-image"
              src="" 
              alt="Nepal Destination"
              title=""
              width="800"
              height="600"
              class="w-full h-full object-cover object-bottom"
              loading="lazy"
              decoding="async"
            />
          </div>

          <!-- 文字說明區域 -->
          <div class="lg:w-1/2 p-8 lg:p-12 flex flex-col justify-center overflow-y-auto relative">
            <h2 id="detail-name" class="text-3xl lg:text-4xl font-serif font-bold text-brand-blue mb-2"></h2>
            <p id="detail-location" class="text-brand-gold text-lg mb-6 font-medium"></p>
            <p id="detail-description" class="text-stone-700 leading-relaxed text-lg mb-12"></p>
            
            <div class="mt-auto flex flex-wrap gap-4 justify-end" id="detail-tour-links-container">
              <a id="detail-tour-link" href="#" target="_blank" style="display: none;" class="items-center gap-2 text-white font-medium transition-all bg-brand-blue hover:bg-brand-gold shadow-md hover:shadow-lg hover:-translate-y-0.5 px-6 py-3 rounded-full tracking-wide">
                {t('itinerary.button.checkTour')}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ItemList Schema (JSON-LD) -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": lang === 'zh-tw' ? '尼泊爾熱門套裝行程' : 'Nepal Tour Packages',
  "description": lang === 'zh-tw'
    ? '探索尼泊爾最受歡迎的旅遊套裝行程，包含高山健行、文化巡禮與野生動物探險'
    : 'Explore Nepal\'s most popular tour packages — Himalayan treks, cultural tours, and wildlife safaris',
  "numberOfItems": 11,
  "itemListElement": [
    { id: 'ebc',              name: lang === 'zh-tw' ? '聖母峰基地營健行 (EBC Trek)'            : 'Everest Base Camp Trek' },
    { id: 'abc',              name: lang === 'zh-tw' ? '安娜普納基地營健行 (ABC Trek)'          : 'Annapurna Base Camp Trek' },
    { id: 'act',              name: lang === 'zh-tw' ? '安娜普納大環線 (Annapurna Circuit)'     : 'Annapurna Circuit Trek' },
    { id: 'gokyo',            name: lang === 'zh-tw' ? '高喬湖健行 (Gokyo Lake Trek)'           : 'Gokyo Lake Trek' },
    { id: 'langtang',         name: lang === 'zh-tw' ? '朗塘谷健行 (Langtang Valley Trek)'      : 'Langtang Valley Trek' },
    { id: 'manaslu',          name: lang === 'zh-tw' ? '馬納斯魯大環線健行 (Manaslu Circuit)'   : 'Manaslu Circuit Trek' },
    { id: 'poon_hill',        name: lang === 'zh-tw' ? '普恩山健行 (Poon Hill Trek)'            : 'Ghorepani Poon Hill Trek' },
    { id: 'chitwan',          name: lang === 'zh-tw' ? '奇旺國家公園叢林探險 (Chitwan Tour)'    : 'Chitwan National Park Tour' },
    { id: 'lumbini',          name: lang === 'zh-tw' ? '藍毗尼佛教聖地朝聖之旅 (Lumbini Tour)' : 'Lumbini Pilgrimage Tour' },
    { id: 'kathmandu_valley', name: lang === 'zh-tw' ? '加德滿都谷地文化之旅'                   : 'Kathmandu Valley Tour' },
    { id: 'bhutan',           name: lang === 'zh-tw' ? '不丹精華 4 天 3 夜'                     : 'Bhutan Highlights Tour (Paro & Thimphu)' },
  ].map((tour, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": tour.name,
    "url": `https://oriental-express-travel.com/${lang}/tours/${tour.id}/`
  }))
})} />

<!-- Embedding Data for JS access -->
<div id="destinations-data" data-destinations={JSON.stringify(destinations)} class="hidden"></div>
<div id="available-tours" data-tours='["ebc", "langtang", "chitwan", "lumbini", "abc", "act", "poon_hill", "manaslu", "gokyo"]' class="hidden"></div>
<!-- Translations for JS -->
<div id="translations-data" 
     data-names={JSON.stringify(destinations.reduce((acc, d) => ({...acc, [d.id]: t(`itinerary.destinations.${d.id}.name`) }), {}))}
     data-locations={JSON.stringify(destinations.reduce((acc, d) => ({...acc, [d.id]: t(`itinerary.destinations.${d.id}.location`) }), {}))}
     data-descriptions={JSON.stringify(destinations.reduce((acc, d) => ({...acc, [d.id]: t(`itinerary.destinations.${d.id}.description`) }), {}))}
     data-ui={JSON.stringify({
       checkTour: t('itinerary.button.checkTour'),
       checkABC: t('itinerary.button.checkABC'),
       checkACT: t('itinerary.button.checkACT'),
       checkEBC: t('itinerary.button.checkEBC'),
       checkGokyo: t('itinerary.button.checkGokyo'),
     })}
     class="hidden">
</div>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const cardsGrid = document.getElementById('cards-grid');
  const detailView = document.getElementById('detail-view');
  const backButton = document.getElementById('back-button');
  const mapNodes = document.querySelectorAll('.map-node');
  
  const detailImage = document.getElementById('detail-image') as HTMLImageElement;
  const detailName = document.getElementById('detail-name');
  const detailLocation = document.getElementById('detail-location');
  const detailDescription = document.getElementById('detail-description');

  // Load Data
  const destinationsElement = document.getElementById('destinations-data');
  const translationsElement = document.getElementById('translations-data');
  const availableToursElement = document.getElementById('available-tours');
  
  const rawDestinations = destinationsElement ? JSON.parse(destinationsElement.dataset.destinations || '[]') : [];
  const names = translationsElement ? JSON.parse(translationsElement.dataset.names || '{}') : {};
  const locations = translationsElement ? JSON.parse(translationsElement.dataset.locations || '{}') : {};
  const descriptions = translationsElement ? JSON.parse(translationsElement.dataset.descriptions || '{}') : {};
  const uiLabels = translationsElement ? JSON.parse(translationsElement.dataset.ui || '{}') : {};
  const availableTours = availableToursElement ? JSON.parse(availableToursElement.dataset.tours || '[]') : [];

  // Map Animation
  // Animate zones drawing in
  gsap.fromTo("#nepal-map-itinerary path", 
    { strokeDashoffset: 1000, strokeDasharray: 1000, fillOpacity: 0 },
    { 
      strokeDashoffset: 0, 
      fillOpacity: 1, 
      duration: 2.0, 
      stagger: 0.05,
      ease: "power2.out",
      scrollTrigger: {
        trigger: "#tours",
        start: "top 70%"
      }
    }
  );

  gsap.fromTo(".map-node",
    { scale: 0, opacity: 0 },
    {
      scale: 1,
      opacity: 1,
      duration: 0.5,
      stagger: 0.05,
      delay: 1.5,
      ease: "back.out(1.7)",
      scrollTrigger: {
        trigger: "#tours",
        start: "top 70%"
      }
    }
  );

  // Unified Open Logic
  function openDetail(id: string) {
      const dest = rawDestinations.find((d:any) => d.id === id);
      if (!dest) return;
      
      const detailTourLink = document.getElementById('detail-tour-link') as HTMLAnchorElement;
      
      // Determine if a tailored itinerary exists
      const container = document.getElementById('detail-tour-links-container');
      if (container) {
          // Clear previous custom buttons (keep the template if needed, but easier to just rebuild)
          container.innerHTML = '';
          
          const multiTourMapping: Record<string, string | string[]> = {
            'kathmandu_durbar': 'kathmandu_valley',
            'patan_durbar': 'kathmandu_valley',
            'boudhanath': 'kathmandu_valley',
            'pashupatinath': 'kathmandu_valley',
            'swayambhunath': 'kathmandu_valley',
            'bhaktapur': 'kathmandu_valley',
            'thamel': 'kathmandu_valley',
            'nagarkot': 'kathmandu_valley',
            'abc': ['abc', 'act'], // Special case: Annapurna Region links to both
            'ebc': ['ebc', 'gokyo'] // Special case: Everest Region links to both
          };
          
          const tourIds = multiTourMapping[id] || (availableTours.includes(id) ? id : null);
          const finalTourIds = Array.isArray(tourIds) ? tourIds : (tourIds ? [tourIds] : []);

          if (finalTourIds.length > 0) {
            const isEn = window.location.pathname.startsWith('/en');
            const baseUrl = isEn ? '/en' : '/zh-tw';
            
            finalTourIds.forEach(tourId => {
              const btn = document.createElement('a');
              btn.href = `${baseUrl}/tours/${tourId}`;
              btn.target = '_blank';
              btn.className = 'flex items-center gap-2 text-white font-medium transition-all bg-brand-blue hover:bg-brand-gold shadow-md hover:shadow-lg hover:-translate-y-0.5 px-6 py-3 rounded-full tracking-wide';
              
              // Custom label logic
              if (tourId === 'abc') btn.textContent = uiLabels.checkABC;
              else if (tourId === 'act') btn.textContent = uiLabels.checkACT;
              else if (tourId === 'ebc') btn.textContent = uiLabels.checkEBC;
              else if (tourId === 'gokyo') btn.textContent = uiLabels.checkGokyo;
              else btn.textContent = uiLabels.checkTour;
              
              container.appendChild(btn);
            });
          }
      }

      const name = names[id];
      const location = locations[id];
      const description = descriptions[id];
      const image = dest.desktopSrc || dest.image;

      // Populate Detail View
      if (detailImage) {
        detailImage.src = image;
        detailImage.alt = `${name} - ${location}`;
        detailImage.title = name;
      }
      if (detailName) detailName.textContent = name;
      if (detailLocation) detailLocation.textContent = location;
      if (detailDescription) detailDescription.textContent = description;

      // Switch View
      const desktopMap = document.getElementById('desktop-map-view');
      const mobileList = document.getElementById('mobile-list-view'); // Specific ID for mobile list

      // Hide both Map and List
      if (desktopMap) {
        gsap.to(desktopMap, { opacity: 0, display: 'none', duration: 0.3 });
      }
      if (mobileList) {
        gsap.to(mobileList, { opacity: 0, display: 'none', duration: 0.3 });
      }

      // Show Detail
      if (detailView) {
          detailView.classList.remove('hidden');
          gsap.fromTo(detailView, 
            { opacity: 0, y: 20, display: 'block' }, 
            { opacity: 1, y: 0, display: 'block', duration: 0.5 }
          );
          document.getElementById('tours')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
  }

  // Map Click Interaction
  mapNodes.forEach(node => {
    node.addEventListener('click', (e) => {
      e.stopPropagation();
      const id = node.getAttribute('data-id');
      if(id) openDetail(id);
    });
  });

  // Mobile List Click Interaction
  const mobileItems = document.querySelectorAll('.mobile-dest-item');
  mobileItems.forEach(item => {
    item.addEventListener('click', (e) => {
      e.stopPropagation();
      const id = item.getAttribute('data-id');
      if(id) openDetail(id);
    });
  });

  // Back Button Interaction
  if (backButton) {
    backButton.addEventListener('click', (e) => {
      e.stopPropagation();
      
      const desktopMap = document.getElementById('desktop-map-view');
      const mobileList = document.getElementById('mobile-list-view');

      if (detailView) {
        gsap.to(detailView, {
          opacity: 0,
          y: 20,
          duration: 0.3,
          onComplete: () => {
            detailView.classList.add('hidden');
            detailView.style.display = 'none'; // Ensure it's hidden

            // Restore View based on Screen Size
            if (window.innerWidth >= 768) {
               if(desktopMap) {
                 desktopMap.style.display = 'block';
                 gsap.to(desktopMap, { opacity: 1, duration: 0.5 });
               }
            } else {
               if(mobileList) {
                  mobileList.style.display = 'block';
                  gsap.to(mobileList, { opacity: 1, duration: 0.5 });
               }
            }
          }
        });
      }
    });
  }

  // Zoom & Pan State
  let currentZoom = 1;
  const maxZoom = 16;
  const minZoom = 1;
  const originalWidth = 800.36517;
  const originalHeight = 454.28867;
  
  // Current ViewBox State (Start fully zoomed out)
  let viewBoxX = 0;
  let viewBoxY = 0;
  let viewBoxW = originalWidth;
  let viewBoxH = originalHeight;

  const svgFn = document.getElementById('nepal-map-itinerary');
  const zoomInBtn = document.getElementById('zoom-in');
  const zoomOutBtn = document.getElementById('zoom-out');
  const mapTooltip = document.getElementById('map-tooltip');

  // Move Tooltip to Body to avoid stacking context issues with Fixed positioning
  if (mapTooltip && mapTooltip.parentElement !== document.body) {
      document.body.appendChild(mapTooltip);
  }

  // Helper: Apply ViewBox
  function applyViewBox() {
      // Boundary Constraints: Prevent map from being dragged completely out
      if (viewBoxX < 0) viewBoxX = 0;
      if (viewBoxX + viewBoxW > originalWidth) viewBoxX = originalWidth - viewBoxW;
      if (viewBoxY < 0) viewBoxY = 0;
      if (viewBoxY + viewBoxH > originalHeight) viewBoxY = originalHeight - viewBoxH;

      if (svgFn) {
        gsap.to(svgFn, {
            attr: { viewBox: `${viewBoxX} ${viewBoxY} ${viewBoxW} ${viewBoxH}` },
            duration: 0.5,
            ease: "power2.out"
        });
      }
      
      // Update Markers Scale (Inverse Scale to keep constant size)
      gsap.to('.map-node', {
        scale: 1 / currentZoom,
        transformOrigin: "center center", 
        duration: 0.5
      });
  }

  function updateZoom(newZoom: number) {
    if (newZoom < minZoom) newZoom = minZoom;
    if (newZoom > maxZoom) newZoom = maxZoom;

    // 1. Calculate the center of the CURRENT view
    const currentCenterX = viewBoxX + viewBoxW / 2;
    const currentCenterY = viewBoxY + viewBoxH / 2;

    // 2. Update Zoom Level
    currentZoom = newZoom;

    // 3. Calculate new Width/Height based on Zoom Factor
    const newW = originalWidth / currentZoom;
    const newH = originalHeight / currentZoom;

    // 4. Calculate new X/Y to keep the same center
    viewBoxX = currentCenterX - newW / 2;
    viewBoxY = currentCenterY - newH / 2;
    viewBoxW = newW;
    viewBoxH = newH;
    
    // Hide Tooltip on Zoom
    if (mapTooltip) mapTooltip.style.opacity = '0';

    applyViewBox();
  }

  // Panning Logic (Draggable)
  let isDragging = false;
  let startX = 0;
  let startY = 0;
  
  if (svgFn) {
      // Mouse Events
      svgFn.addEventListener('mousedown', onDragStart);
      svgFn.addEventListener('mousemove', onDragMove);
      window.addEventListener('mouseup', onDragEnd);
      
      // Touch Events for Mobile
      svgFn.addEventListener('touchstart', onDragStart, { passive: false });
      svgFn.addEventListener('touchmove', onDragMove, { passive: false });
      window.addEventListener('touchend', onDragEnd);
      
      // Prevent default drag behavior
      svgFn.style.cursor = 'grab';
  }

  function onDragStart(e: MouseEvent | TouchEvent) {
      // Hide Tooltip on Drag Start
      if (mapTooltip) mapTooltip.style.opacity = '0';

      // Don't drag if clicking a node
      if ((e.target as HTMLElement).closest('.map-node')) return;
      
      isDragging = true;
      if (svgFn) svgFn.style.cursor = 'grabbing';
      
      // Get pointer position
      const clientX = (e as MouseEvent).clientX || (e as TouchEvent).touches[0].clientX;
      const clientY = (e as MouseEvent).clientY || (e as TouchEvent).touches[0].clientY;
      
      startX = clientX;
      startY = clientY;
  }
  
  // Hide Tooltip on Scroll (Global) - Prevents "floating" tag when page moves
  window.addEventListener('scroll', () => {
      if (mapTooltip) mapTooltip.style.opacity = '0';
  }, { passive: true });

  function onDragMove(e: MouseEvent | TouchEvent) {
      if (!isDragging) return;
      e.preventDefault(); // Prevent scrolling on touch

      const clientX = (e as MouseEvent).clientX || (e as TouchEvent).touches[0].clientX;
      const clientY = (e as MouseEvent).clientY || (e as TouchEvent).touches[0].clientY;

      const dx = clientX - startX;
      const dy = clientY - startY;

      // Convert Screen Delta to SVG User Unit Delta
      const svgRect = svgFn!.getBoundingClientRect();
      const scaleX = viewBoxW / svgRect.width;
      const scaleY = viewBoxH / svgRect.height;

      // Update viewBox coordinates
      viewBoxX -= dx * scaleX;
      viewBoxY -= dy * scaleY;

      // Boundary Constraints: Prevent dragging outside map bounds
      if (viewBoxX < 0) viewBoxX = 0;
      if (viewBoxX + viewBoxW > originalWidth) viewBoxX = originalWidth - viewBoxW;
      if (viewBoxY < 0) viewBoxY = 0;
      if (viewBoxY + viewBoxH > originalHeight) viewBoxY = originalHeight - viewBoxH;

      svgFn!.setAttribute('viewBox', `${viewBoxX} ${viewBoxY} ${viewBoxW} ${viewBoxH}`);

      startX = clientX;
      startY = clientY;
  }

  function onDragEnd() {
      if (isDragging) {
        isDragging = false;
        if (svgFn) svgFn.style.cursor = 'grab';
      }
  }

  // Tooltip Logic
  mapNodes.forEach(node => {
      node.addEventListener('mouseenter', (e) => {
          const id = node.getAttribute('data-id');
          if (id && mapTooltip) {
              const name = names[id];
              mapTooltip.textContent = name;
              
              // Position fixed to the node (Spot)
              const rect = node.getBoundingClientRect();
              const centerX = rect.left + rect.width / 2;
              const topY = rect.top;
              
              mapTooltip.style.left = `${centerX}px`;
              mapTooltip.style.top = `${topY}px`;
              mapTooltip.style.transform = 'translate(-50%, -120%)'; // Center above
              
              mapTooltip.style.opacity = '1';
          }
      });

      // Removed mousemove (User prefers fixed position on spot)
      /*
      node.addEventListener('mousemove', (e) => {
          if (mapTooltip) {
             const offset = 15;
             mapTooltip.style.left = (e.clientX + offset) + 'px';
             mapTooltip.style.top = (e.clientY + offset) + 'px';
          }
      });
      */

      node.addEventListener('mouseleave', () => {
          if (mapTooltip) {
              mapTooltip.style.opacity = '0';
          }
      });
  });

  // Map Filter Logic
  const filterBtns = document.querySelectorAll('.filter-btn');

  filterBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const category = btn.getAttribute('data-category');
          
          // Update Active State
          filterBtns.forEach(b => {
             b.classList.remove('bg-brand-blue', 'text-white', 'shadow-md');
             b.classList.add('text-stone-600', 'hover:text-brand-blue', 'hover:bg-white');
          });
          btn.classList.remove('text-stone-600', 'hover:text-brand-blue', 'hover:bg-white');
          btn.classList.add('bg-brand-blue', 'text-white', 'shadow-md');

          // Filter nodes
          mapNodes.forEach(node => {
              const nodeCat = node.getAttribute('data-category');
              if (category === 'all' || nodeCat === category) {
                  gsap.to(node, { opacity: 1, duration: 0.3 });
                  node.style.pointerEvents = 'auto';
              } else {
                  gsap.to(node, { opacity: 0, duration: 0.3 });
                  node.style.pointerEvents = 'none';
              }
          });
      });
  });

  // Buttons
  const recenterBtn = document.getElementById('recenter-map');
  if (recenterBtn) {
      recenterBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          viewBoxX = (originalWidth - viewBoxW) / 2;
          viewBoxY = (originalHeight - viewBoxH) / 2;
          applyViewBox();
      });
  }

  if (zoomInBtn && zoomOutBtn) {
      zoomInBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          updateZoom(currentZoom * 1.5);
      });

      zoomOutBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          updateZoom(currentZoom / 1.5);
      });
  }
</script>

<style>
  #cards-grid,
  #detail-view {
    opacity: 1;
  }

  .destination-card {
    position: relative;
    transition: transform 0.3s ease;
    -webkit-tap-highlight-color: transparent;
    will-change: transform;
  }

  @media (hover: hover) and (pointer: fine) {
    .destination-card:hover {
      transform: translateY(-4px);
    }
    
    .destination-card:hover .card-image {
      transform: scale(1.05);
    }
  }

  .card-image {
    transition: transform 0.5s ease;
  }

  @media (hover: none) and (pointer: coarse) {
    .destination-card:active {
      transform: scale(0.98);
    }
  }

  #detail-view {
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  #detail-image {
    min-height: 100%;
  }
</style>