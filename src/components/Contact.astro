---
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: 'zh-tw' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="contactUs" class="relative py-20 px-6 overflow-hidden">
  <!-- Dark gradient background -->
  <div class="absolute inset-0 bg-brand-blue"></div>
  
  <!-- Subtle texture overlay -->
  <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>

  <div class="relative max-w-6xl mx-auto">
    <!-- Title Section -->
    <div class="contact-title-block text-center mb-12">
      <div class="inline-block mb-6">
        <div class="h-0.5 w-16 bg-brand-gold mx-auto"></div>
      </div>
      <h2 class="text-3xl md:text-4xl font-serif font-bold text-white mb-4">
        {t('contact.title')}
      </h2>
      <p class="text-xl text-stone-300">
        {t('contact.subtitle')}
      </p>
    </div>

    <!-- Contact Card -->
    <div class="contact-card bg-stone-700/50 backdrop-blur-sm rounded-2xl border border-stone-600/50 p-8 md:p-12">
      <!-- Company Information -->
      <div class="mb-10 pb-8 border-b border-stone-600/50">
        <p class="text-stone-400 text-sm mb-2 uppercase tracking-wide">{t('contact.companyLabel')}</p>
        <h3 class="text-2xl md:text-3xl font-serif font-bold text-white">Oriental Express Travel P. Ltd.</h3>
      </div>
      
      <!-- Contact Info Grid -->
      <div class="grid md:grid-cols-2 gap-6 mb-10">
        <!-- Phone -->
        <div class="group flex items-start gap-4 p-4 rounded-xl hover:bg-stone-600/30 transition-all">
          <div class="w-14 h-14 bg-gradient-to-br from-brand-gold to-yellow-600 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
          </div>
          <div class="flex flex-col">
            <p class="text-stone-400 text-sm mb-1">{t('contact.phone')}</p>
            <a href="tel:+9779818840319" class="inline-block text-base md:text-lg font-semibold text-white hover:text-brand-gold transition w-fit">
              +977-9818840319
            </a>
            <a href="tel:+9779713615345" class="inline-block text-base md:text-lg font-semibold text-white hover:text-brand-gold transition w-fit">
              +977-9713615345
            </a>
          </div>
        </div>
        
        <!-- Email -->
        <a href="mailto:ktmoriental@gmail.com" class="group flex items-start gap-4 p-4 rounded-xl hover:bg-stone-600/30 transition-all">
          <div class="w-14 h-14 bg-gradient-to-br from-brand-gold to-yellow-600 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </div>
          <div class="min-w-0">
            <p class="text-stone-400 text-sm mb-1">{t('contact.email')}</p>
            <p class="text-base md:text-lg font-semibold text-white group-hover:text-brand-gold transition break-all">
              ktmoriental@gmail.com
            </p>
          </div>
        </a>

         <!-- WhatsApp -->
        <a href="https://wa.me/9779818840319" target="_blank" rel="noopener noreferrer" class="group flex items-start gap-4 p-4 rounded-xl hover:bg-stone-600/30 transition-all">
          <div class="w-14 h-14 bg-gradient-to-br from-[#25D366] to-[#1da851] rounded-xl flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform">
            <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </div>
          <div>
            <p class="text-stone-400 text-sm mb-1">WhatsApp</p>
            <p class="text-base md:text-lg font-semibold text-white group-hover:text-[#25D366] transition">
              +977-9818840319
            </p>
          </div>
        </a>

        <!-- LINE -->
        <a href="https://line.me/ti/p/~ru4s94m6" target="_blank" rel="noopener noreferrer" class="group flex items-start gap-4 p-4 rounded-xl hover:bg-stone-600/30 transition-all">
          <div class="w-14 h-14 bg-gradient-to-br from-[#00B900] to-[#009900] rounded-xl flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform">
            <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.070 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
            </svg>
          </div>
          <div>
            <p class="text-stone-400 text-sm mb-1">LINE</p>
            <p class="text-base md:text-lg font-semibold text-white group-hover:text-[#00B900] transition">
              +886-900033331
            </p>
          </div>
        </a>

        <!-- Instagram -->
        <a href="https://www.instagram.com/orientalexpress.travel/" target="_blank" rel="noopener noreferrer" class="group flex items-start gap-4 p-4 rounded-xl hover:bg-stone-600/30 transition-all">
          <div class="w-14 h-14 bg-gradient-to-br from-pink-500 to-purple-600 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform">
            <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </div>
          <div>
            <p class="text-stone-400 text-sm mb-1">Instagram</p>
            <p class="text-base md:text-lg font-semibold text-white group-hover:text-pink-400 transition">
              @orientalexpress.travel
            </p>
          </div>
        </a>

        <!-- Address -->
        <a
          href="https://www.google.com/maps/search/Oriental+Express+Travel+Pvt.+Ltd/@27.7155548,85.313426,17z" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="group flex items-start gap-4 p-4 rounded-xl hover:bg-stone-600/30 transition-all"
        >
          <div class="w-14 h-14 bg-gradient-to-br from-green-500 to-emerald-600 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <div>
            <p class="text-stone-400 text-sm mb-1">{t('contact.address') || '地址'}</p>
            <p class="text-base md:text-lg font-semibold text-white group-hover:text-green-400 transition leading-relaxed">
              Unit 323, 2nd floor, Chhaya Center,<br />
              Thamel, Kathmandu, Nepal
            </p>
          </div>
        </a>
      </div>

      <!-- Embedded Google Map -->
      <div class="w-full h-64 md:h-80 rounded-xl overflow-hidden border border-stone-600/50 relative group">
        <div class="absolute inset-0 bg-brand-blue/10 group-hover:opacity-0 transition-opacity duration-500 pointer-events-none z-10"></div>
        <iframe 
          title="Google Map location of Oriental Express Travel"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d14128.217617433807!2d85.30306666364471!3d27.71560646496436!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x39eb192bb9d388df%3A0x9b5eb9f0e1c6eee1!2sOriental%20Express%20Travel%20Pvt.%20Ltd!5e0!3m2!1szh-TW!2stw!4v1776596842086!5m2!1szh-TW!2stw" 
          width="100%" 
          height="100%" 
          style="border:0;" 
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade"
          class="opacity-90 group-hover:opacity-100 transition-opacity duration-500"
        ></iframe>
      </div>

      <!-- Bottom message -->
      <div class="pt-8 border-t border-stone-600/50">
        <p class="text-center text-stone-300 text-lg">
          {t('contact.cta')}
        </p>
      </div>
    </div>

    <!-- Footer-like info -->
    <div class="mt-8 text-center">
      <p class="text-stone-500 text-sm">
        © 2026 Oriental Express Travel P. Ltd. All rights reserved.
      </p>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  gsap.from('.contact-title-block', {
    opacity: 0, y: 32, duration: 0.8, ease: 'power3.out',
    scrollTrigger: { trigger: '#contactUs', start: 'top 80%', once: true },
  });
  gsap.from('.contact-card', {
    opacity: 0, y: 48, duration: 1.0, ease: 'power3.out',
    scrollTrigger: { trigger: '#contactUs', start: 'top 75%', once: true },
  });
</script>

