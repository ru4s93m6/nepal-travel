---
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: 'zh-tw' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="contactUs" class="relative py-20 px-6 overflow-hidden">
  <!-- Dark gradient background -->
  <div class="absolute inset-0 bg-brand-blue"></div>
  
  <!-- Subtle texture overlay -->
  <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>

  <div class="relative max-w-6xl mx-auto">
    <!-- Title Section -->
    <div class="text-center mb-12">
      <div class="inline-block mb-6">
        <div class="h-0.5 w-16 bg-brand-gold mx-auto"></div>
      </div>
      <h2 class="text-3xl md:text-4xl font-serif font-bold text-white mb-4">
        {t('contact.title')}
      </h2>
      <p class="text-xl text-stone-300">
        {t('contact.subtitle')}
      </p>
    </div>
    
    <!-- Contact Card -->
    <div class="bg-stone-700/50 backdrop-blur-sm rounded-2xl border border-stone-600/50 p-8 md:p-12">
      <!-- Company Information -->
      <div class="mb-10 pb-8 border-b border-stone-600/50">
        <p class="text-stone-400 text-sm mb-2 uppercase tracking-wide">{t('contact.companyLabel')}</p>
        <h3 class="text-2xl md:text-3xl font-serif font-bold text-white">Oriental Express Travel P. Ltd.</h3>
      </div>
      
      <!-- Contact Info Grid -->
      <div class="grid md:grid-cols-2 gap-6 mb-10">
        <!-- Phone -->
        <div class="group flex items-start gap-4 p-4 rounded-xl hover:bg-stone-600/30 transition-all">
          <div class="w-14 h-14 bg-gradient-to-br from-brand-gold to-yellow-600 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
          </div>
          <div class="flex flex-col">
            <p class="text-stone-400 text-sm mb-1">{t('contact.phone')}</p>
            <a href="tel:+9779818840319" class="inline-block text-base md:text-lg font-semibold text-white hover:text-brand-gold transition w-fit">
              +977-9818840319
            </a>
            <a href="tel:+9779713615345" class="inline-block text-base md:text-lg font-semibold text-white hover:text-brand-gold transition w-fit">
              +977-9713615345
            </a>
          </div>
        </div>
        
        <!-- Email -->
        <a href="mailto:operation@expressoriental.com" class="group flex items-start gap-4 p-4 rounded-xl hover:bg-stone-600/30 transition-all">
          <div class="w-14 h-14 bg-gradient-to-br from-brand-gold to-yellow-600 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </div>
          <div class="min-w-0">
            <p class="text-stone-400 text-sm mb-1">{t('contact.email')}</p>
            <p class="text-base md:text-lg font-semibold text-white group-hover:text-brand-gold transition break-all">
              operation@expressoriental.com
            </p>
          </div>
        </a>

        <!-- Instagram -->
        <a href="https://www.instagram.com/orientalexpress.travel/" target="_blank" rel="noopener noreferrer" class="group flex items-start gap-4 p-4 rounded-xl hover:bg-stone-600/30 transition-all">
          <div class="w-14 h-14 bg-gradient-to-br from-pink-500 to-purple-600 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform">
            <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </div>
          <div>
            <p class="text-stone-400 text-sm mb-1">Instagram</p>
            <p class="text-base md:text-lg font-semibold text-white group-hover:text-pink-400 transition">
              @orientalexpress.travel
            </p>
          </div>
        </a>

      <!-- Address -->
        <a 
          href="https://www.google.com/maps/search/Oriental+Express+Travel+Pvt.+Ltd/@27.7155548,85.313426,17z" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="group flex items-start gap-4 p-4 rounded-xl hover:bg-stone-600/30 transition-all"
        >
          <div class="w-14 h-14 bg-gradient-to-br from-green-500 to-emerald-600 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <div>
            <p class="text-stone-400 text-sm mb-1">{t('contact.address') || '地址'}</p>
            <p class="text-base md:text-lg font-semibold text-white group-hover:text-green-400 transition leading-relaxed">
              Unit 323, 2nd floor, Chhaya Center,<br />
              Thamel, Kathmandu, Nepal
            </p>
          </div>
        </a>
      </div>

      <!-- Embedded Google Map -->
      <div class="w-full h-64 md:h-80 rounded-xl overflow-hidden border border-stone-600/50 relative group">
        <div class="absolute inset-0 bg-brand-blue/10 group-hover:opacity-0 transition-opacity duration-500 pointer-events-none z-10"></div>
        <iframe 
          title="Google Map location of Oriental Express Travel"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d14128.217617433807!2d85.30306666364471!3d27.71560646496436!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x39eb192bb9d388df%3A0x9b5eb9f0e1c6eee1!2sOriental%20Express%20Travel%20Pvt.%20Ltd!5e0!3m2!1szh-TW!2stw!4v1776596842086!5m2!1szh-TW!2stw" 
          width="100%" 
          height="100%" 
          style="border:0;" 
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade"
          class="opacity-90 group-hover:opacity-100 transition-opacity duration-500"
        ></iframe>
      </div>

      <!-- Bottom message -->
      <div class="pt-8 border-t border-stone-600/50">
        <p class="text-center text-stone-300 text-lg">
          {t('contact.cta')}
        </p>
      </div>
    </div>

    <!-- Footer-like info -->
    <div class="mt-8 text-center">
      <p class="text-stone-500 text-sm">
        © 2026 Oriental Express Travel P. Ltd. All rights reserved.
      </p>
    </div>
  </div>
</section>
