---
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: 'zh-tw' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="contactUs" class="relative py-20 px-6 overflow-hidden">
  <!-- Dark gradient background -->
  <div class="absolute inset-0 bg-gradient-to-b from-stone-800 via-stone-800 to-stone-900"></div>
  
  <!-- Subtle texture overlay -->
  <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>

  <div class="relative max-w-6xl mx-auto">
    <!-- Title Section -->
    <div class="text-center mb-12">
      <div class="inline-block mb-6">
        <div class="h-0.5 w-16 bg-amber-500 mx-auto"></div>
      </div>
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        {t('contact.title')}
      </h2>
      <p class="text-xl text-stone-300">
        {t('contact.subtitle')}
      </p>
    </div>
    
    <!-- Contact Card -->
    <div class="bg-stone-700/50 backdrop-blur-sm rounded-2xl border border-stone-600/50 p-8 md:p-12">
      <!-- Company Information -->
      <div class="mb-10 pb-8 border-b border-stone-600/50">
        <p class="text-stone-400 text-sm mb-2 uppercase tracking-wide">{t('contact.companyLabel')}</p>
        <h3 class="text-2xl md:text-3xl font-bold text-white">Oriental Express Travel P. Ltd.</h3>
      </div>
      
      <!-- Contact Info Grid -->
      <div class="grid md:grid-cols-2 gap-6 mb-10">
        <!-- Phone -->
        <a href="tel:+9779818840319" class="group flex items-start gap-4 p-4 rounded-xl hover:bg-stone-600/30 transition-all">
          <div class="w-14 h-14 bg-gradient-to-br from-amber-500 to-orange-600 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
          </div>
          <div>
            <p class="text-stone-400 text-sm mb-1">{t('contact.phone')}</p>
            <p class="text-base md:text-lg font-semibold text-white group-hover:text-amber-400 transition">
              +977-9818840319
            </p>
          </div>
        </a>
        
        <!-- Email -->
        <a href="mailto:operation@expressoriental.com" class="group flex items-start gap-4 p-4 rounded-xl hover:bg-stone-600/30 transition-all">
          <div class="w-14 h-14 bg-gradient-to-br from-amber-500 to-orange-600 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </div>
          <div class="min-w-0">
            <p class="text-stone-400 text-sm mb-1">{t('contact.email')}</p>
            <p class="text-base md:text-lg font-semibold text-white group-hover:text-amber-400 transition break-all">
              operation@expressoriental.com
            </p>
          </div>
        </a>

        <!-- Instagram -->
        <a href="https://www.instagram.com/orientalexpress.travel/" target="_blank" rel="noopener noreferrer" class="group flex items-start gap-4 p-4 rounded-xl hover:bg-stone-600/30 transition-all">
          <div class="w-14 h-14 bg-gradient-to-br from-pink-500 to-purple-600 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform">
            <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </div>
          <div>
            <p class="text-stone-400 text-sm mb-1">Instagram</p>
            <p class="text-base md:text-lg font-semibold text-white group-hover:text-pink-400 transition">
              @orientalexpress.travel
            </p>
          </div>
        </a>

        <!-- Address -->
        <a href="https://maps.google.com/?q=Chhaya Center" target="_blank" rel="noopener noreferrer" class="group flex items-start gap-4 p-4 rounded-xl hover:bg-stone-600/30 transition-all">
          <div class="w-14 h-14 bg-gradient-to-br from-green-500 to-emerald-600 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <div>
            <p class="text-stone-400 text-sm mb-1">{t('contact.address') || '地址'}</p>
            <p class="text-base md:text-lg font-semibold text-white group-hover:text-green-400 transition leading-relaxed">
              Unit 323, 2nd floor, Chhaya Center,<br />
              Thamel, Kathmandu, Nepal
            </p>
          </div>
        </a>
      </div>

      <!-- Bottom message -->
      <div class="pt-8 border-t border-stone-600/50">
        <p class="text-center text-stone-300 text-lg">
          {t('contact.cta')}
        </p>
      </div>
    </div>

    <!-- Footer-like info -->
    <div class="mt-8 text-center">
      <p class="text-stone-500 text-sm">
        © 2025 Oriental Express Travel P. Ltd. All rights reserved.
      </p>
    </div>
  </div>
</section>

<!-- Fixed WhatsApp Button -->
<a 
  href="https://wa.me/9779818840319" 
  target="_blank"
  rel="noopener noreferrer"
  class="fixed bottom-6 right-6 w-16 h-16 bg-green-500 hover:bg-green-600 rounded-full flex items-center justify-center shadow-lg hover:shadow-xl transition-all z-50 group"
  aria-label="Contact us on WhatsApp"
>
  <svg class="w-8 h-8 text-white group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
  </svg>
</a>