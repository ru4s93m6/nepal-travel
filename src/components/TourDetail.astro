---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import type { TourData } from '../data/tours/ebc';

interface Props {
  tour: TourData;
}

const { tour } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const content = tour.locales[lang];

// UI Strings for Tour Detail Page
const ui = {
  'zh-tw': {
    overview: '行程總覽',
    itinerary: '每日行程',
    includes: '費用包含與不含',
    gear: '建議裝備',
    duration: '行程天數',
    difficulty: '難度',
    maxAlt: '最高海拔',
    day: 'Day',
    daySuffix: '',
  },
  'en': {
    overview: 'Overview',
    itinerary: 'Itinerary',
    includes: 'Includes & Excludes',
    gear: 'Equipment',
    duration: 'Duration',
    difficulty: 'Difficulty',
    maxAlt: 'Max Altitude',
    day: 'Day',
    daySuffix: '',
  }
}[lang];

---
<div class="tour-detail-page bg-brand-cream min-h-screen font-sans">
  <!-- Hero Section -->
  <section class="relative h-[65vh] min-h-[500px] flex items-center justify-center pt-20">
    <img src={tour.heroImage} alt={content.title} class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black/70"></div>
    
    <div class="relative z-10 text-center px-4 max-w-5xl mt-12">
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-serif font-bold text-white mb-6 drop-shadow-2xl leading-tight text-shadow-sm">{content.title}</h1>
      <p class="text-xl md:text-2xl text-white/90 drop-shadow-lg mb-10 max-w-3xl mx-auto">{content.subtitle}</p>
      
      <!-- Quick Facts -->
      <div class="flex flex-wrap justify-center gap-x-8 gap-y-4 bg-black/40 backdrop-blur-md border border-white/20 rounded-2xl p-6 text-white text-lg max-w-3xl mx-auto shadow-2xl">
        <div class="flex flex-col items-center flex-1 min-w-[120px]">
          <span class="text-white/60 text-sm mb-1 uppercase tracking-wider font-semibold">{ui.duration}</span>
          <span class="font-bold text-xl">{tour.durationDays} Days</span>
        </div>
        <div class="w-px bg-white/20 hidden md:block"></div>
        <div class="flex flex-col items-center flex-1 min-w-[120px]">
          <span class="text-white/60 text-sm mb-1 uppercase tracking-wider font-semibold">{ui.maxAlt}</span>
          <span class="font-bold text-xl">{tour.maxAltitude} m</span>
        </div>
        <div class="w-px bg-white/20 hidden md:block"></div>
        <div class="flex flex-col items-center flex-1 min-w-[120px]">
          <span class="text-white/60 text-sm mb-1 uppercase tracking-wider font-semibold">{ui.difficulty}</span>
          <span class="font-bold text-xl">{tour.difficulty}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Sticky Tab Navigation -->
  <div class="sticky top-[73px] md:top-[88px] z-40 bg-white/95 backdrop-blur-md border-b border-stone-200 shadow-sm" id="tour-tabs">
    <div class="max-w-6xl mx-auto px-4 flex overflow-x-auto hide-scrollbar gap-8 text-brand-blue font-bold whitespace-nowrap">
      <a href="#overview" class="tab-link active py-4 border-b-[3px] border-transparent hover:border-brand-gold transition-colors">{ui.overview}</a>
      <a href="#itinerary" class="tab-link py-4 border-b-[3px] border-transparent hover:border-brand-gold transition-colors">{ui.itinerary}</a>
      <a href="#includes" class="tab-link py-4 border-b-[3px] border-transparent hover:border-brand-gold transition-colors">{ui.includes}</a>
      <a href="#gear" class="tab-link py-4 border-b-[3px] border-transparent hover:border-brand-gold transition-colors">{ui.gear}</a>
    </div>
  </div>

  <!-- Content Sections -->
  <main class="max-w-4xl mx-auto px-4 flex flex-col gap-12 py-12 pb-32">
    
    <div class="flex flex-col gap-16">
        <!-- Overview Section -->
        <section id="overview" class="scroll-mt-32">
          <h2 class="text-3xl font-serif font-bold text-brand-blue mb-6 flex items-center gap-3">
             <span class="w-8 h-1 bg-brand-gold inline-block rounded-full"></span> 
             {ui.overview}
          </h2>
          <p class="text-lg text-stone-700 leading-relax mb-8 whitespace-pre-line">{content.overview}</p>
          
          <div class="bg-white p-8 rounded-2xl shadow-sm border border-stone-200">
            <h3 class="text-xl font-bold text-brand-blue mb-5">⭐ Trip Highlights</h3>
            <ul class="space-y-4">
              {content.highlights.map(h => (
                <li class="flex items-start gap-4 text-stone-700 text-lg">
                   <svg class="w-6 h-6 text-brand-gold flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                   <span>{h}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>
    
        <!-- Itinerary Section (Accordion) -->
        <section id="itinerary" class="scroll-mt-32">
          <h2 class="text-3xl font-serif font-bold text-brand-blue mb-6 flex items-center gap-3">
             <span class="w-8 h-1 bg-brand-gold inline-block rounded-full"></span> 
             {ui.itinerary}
          </h2>
          <div class="space-y-4">
            {content.itinerary.map((day, index) => (
              <details class="group bg-white rounded-xl shadow-sm border border-stone-200 overflow-hidden" open={index === 0}>
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none p-6 text-xl text-brand-blue hover:bg-stone-50 transition-colors">
                  <span class="font-bold flex items-center gap-4">
                     <span class="bg-brand-blue text-white text-sm px-4 py-1.5 rounded-full shadow-sm whitespace-nowrap">{ui.day} {day.day} {ui.daySuffix}</span>
                     {day.title}
                  </span>
                  <span class="transition group-open:rotate-180 text-brand-gold ml-4">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <div class="text-stone-600 p-6 pt-0 text-lg leading-relaxed border-t border-stone-100 bg-stone-50/50">
                  <p class="mt-4">{day.description}</p>
                </div>
              </details>
            ))}
          </div>
        </section>
    
        <!-- Includes/Excludes Section -->
        <section id="includes" class="scroll-mt-32">
          <h2 class="text-3xl font-serif font-bold text-brand-blue mb-6 flex items-center gap-3">
             <span class="w-8 h-1 bg-brand-gold inline-block rounded-full"></span> 
             {ui.includes}
          </h2>
          <div class="flex flex-col md:flex-row gap-6">
            <!-- Includes -->
            <div class="flex-1 bg-white p-8 rounded-2xl shadow-sm border border-stone-200">
              <h3 class="text-2xl font-bold text-emerald-700 mb-6 flex items-center gap-2">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                {lang === 'zh-tw' ? '費用包含' : "What's Included"}
              </h3>
              <ul class="space-y-4">
                {content.includes.map(item => (
                  <li class="flex items-start gap-3 text-stone-700 text-lg">
                     <svg class="w-6 h-6 text-emerald-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                     <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
            <!-- Excludes -->
            <div class="flex-1 bg-white p-8 rounded-2xl shadow-sm border border-stone-200">
              <h3 class="text-2xl font-bold text-stone-600 mb-6 flex items-center gap-2">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                {lang === 'zh-tw' ? '費用不含' : "What's Not Included"}
              </h3>
              <ul class="space-y-4">
                {content.excludes.map(item => (
                  <li class="flex items-start gap-3 text-stone-500 text-lg">
                     <svg class="w-6 h-6 text-stone-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                     <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>
    
        <!-- Equipment List -->
        <section id="gear" class="scroll-mt-32">
          <h2 class="text-3xl font-serif font-bold text-brand-blue mb-6 flex items-center gap-3">
             <span class="w-8 h-1 bg-brand-gold inline-block rounded-full"></span> 
             {ui.gear}
          </h2>
          <div class="bg-white p-8 rounded-2xl shadow-sm border border-stone-200">
            <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {content.notes.map(item => (
                <li class="flex items-start gap-3 text-stone-700 bg-stone-50 px-5 py-4 rounded-xl border border-stone-200 shadow-sm text-lg">
                   <span class="text-brand-gold font-bold text-2xl leading-none mt-[-2px]">•</span>
                   <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>
    </div>
  </main>
</div>

<script>
  // Simple active tab highlight on scroll
  const sections = document.querySelectorAll('main section[id]');
  const navLinks = document.querySelectorAll('.tab-link');

  window.addEventListener('scroll', () => {
    let current = '';
    
    sections.forEach(section => {
      const sectionTop = (section as HTMLElement).offsetTop;
      if (scrollY >= sectionTop - 200) {
        current = section.getAttribute('id') || '';
      }
    });

    navLinks.forEach(link => {
      link.classList.remove('border-brand-gold', 'text-brand-gold');
      link.classList.add('border-transparent');
      if (link.getAttribute('href') === `#${current}`) {
        link.classList.remove('border-transparent');
        link.classList.add('border-brand-gold', 'text-brand-gold');
      }
    });
  });
</script>

<style>
  html {
    scroll-behavior: smooth;
  }
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
