---
interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  url?: string;
  lang?: 'zh-tw' | 'en';
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title = 'Oriental Express Travel - 尼泊爾旅遊專家 | Nepal Travel Expert',
  description = '深耕尼泊爾超過20年的在地旅行社。提供聖母峰基地營、安娜普納環線等專業健行行程，客製化家庭旅遊與多語言嚮導服務。讓我們帶您探索喜馬拉雅山的壯麗美景。',
  keywords = '尼泊爾旅遊,Nepal travel,聖母峰,Everest,安娜普納,Annapurna,加德滿都,Kathmandu,博卡拉,Pokhara,尼泊爾健行,Nepal trekking,喜馬拉雅山,Himalayas,在地導遊,local guide',
  image = '/og-image.jpg',
  url = 'https://nepal-travel.vercel.app',
  lang = 'zh-tw',
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || url);
const ogImageURL = new URL(image, Astro.site || url);

const latitude = "27.7145";
const longitude = "85.3120";

// Alternate language URLs
const zhtwURL = new URL('/zh-tw' + Astro.url.pathname.replace('/en', ''), Astro.site || url);
const enURL = new URL('/en' + Astro.url.pathname.replace('/zh-tw', ''), Astro.site || url);
---

<!-- Primary Meta Tags -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="author" content="Oriental Express Travel P. Ltd." />
<meta name="language" content={lang} />

<!-- Robots -->
{noindex && <meta name="robots" content="noindex, nofollow" />}
{!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Alternate Language URLs (hreflang) -->
<link rel="alternate" hreflang="zh-tw" href={zhtwURL} />
<link rel="alternate" hreflang="en" href={enURL} />
<link rel="alternate" hreflang="x-default" href={zhtwURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:locale" content={lang === 'zh-tw' ? 'zh_TW' : 'en_US'} />
<meta property="og:locale:alternate" content={lang === 'zh-tw' ? 'en_US' : 'zh_TW'} />
<meta property="og:site_name" content="Oriental Express Travel" />

{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
<meta name="twitter:image:alt" content={title} />

<!-- Favicon -->
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="manifest" href="/site.webmanifest" />

<!-- Theme Color -->
<meta name="theme-color" content="#F59E0B" />
<meta name="msapplication-TileColor" content="#F59E0B" />

<!-- Geo Tags -->
<meta name="geo.region" content="NP" />
<meta name="geo.placename" content="Thamel, Kathmandu" />
<meta name="geo.position" content={`${latitude};${longitude}`} />
<meta name="ICBM" content={`${latitude}, ${longitude}`} />

<!-- Additional SEO Tags -->
<meta name="rating" content="general" />
<meta name="distribution" content="global" />
<meta name="revisit-after" content="7 days" />

<!-- Business Schema (JSON-LD) -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TravelAgency",
  "name": "Oriental Express Travel P. Ltd.",
  "description": description,
  "url": url,
  "logo": new URL('/logo.png', Astro.site || url),
  "image": ogImageURL,
  "telephone": "+977-9818840319",
  "email": "info@orientalexpress.com.np",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Unit 323, 2nd floor, Chhaya Center, Thamel",
    "addressLocality": "Kathmandu",
    "addressRegion": "Bagmati",
    "postalCode": "44600",
    "addressCountry": "NP"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": latitude,
    "longitude": longitude
  },
  "priceRange": "$$",
  "areaServed": {
    "@type": "Country",
    "name": "Nepal"
  },
  "sameAs": [
    "https://expressoriental.com/",
    "https://www.instagram.com/orientalexpress.travel/"
  ],
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday"
      ],
      "opens": "09:00",
      "closes": "18:00"
    }
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.8",
    "reviewCount": "127"
  }
})} />

<!-- Website Schema -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Oriental Express Travel",
  "url": url,
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": `${url}/search?q={search_term_string}`
    },
    "query-input": "required name=search_term_string"
  }
})} />

{Astro.url.pathname !== '/' && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": url
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": title,
        "item": canonicalURL
      }
    ]
  })} />
)}

<title>{title}</title>