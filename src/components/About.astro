---
import { useTranslations } from '../i18n/utils';
import { Image } from 'astro:assets';
import busGroup from '../assets/bus-group.webp';
import busExterior from '../assets/bus-exterior.webp';
import busInterior from '../assets/bus-interior.webp';
import privateSuvJomsom from '../assets/private-suv-jomsom.webp';
import soloTravelBus from '../assets/solo-travel-bus.webp';
import director from '../assets/director.webp';

interface Props {
  lang: 'zh-tw' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="aboutUs" class="py-20 px-6 bg-white">
  <div class="max-w-6xl mx-auto">
    <!-- Section title -->
    <h2 class="about-section-title text-4xl md:text-5xl font-serif font-bold mb-6 text-center text-brand-blue">
      {t('about.title')}
    </h2>

    <!-- About text -->
    <div class="about-text-block max-w-3xl mx-auto space-y-4 mb-12">
      <h3 class="text-3xl font-serif font-bold text-brand-blue leading-tight">
        {t('about.subtitle')}
      </h3>
      <p class="text-lg text-stone-700 leading-relaxed">
        {t('about.intro')}
      </p>
      <p class="text-lg text-stone-700 leading-relaxed">
        {t('about.experience')}
      </p>
    </div>

    <!-- Team portraits -->
    <div class="grid md:grid-cols-2 gap-8 mb-12">
      <!-- Raju -->
      <div class="founder-image-container group bg-white rounded-lg overflow-hidden shadow-md border border-stone-100 hover:shadow-xl transition-shadow duration-300">
        <div class="relative overflow-hidden">
          <div class="absolute top-4 left-4 z-10">
            <span class="bg-brand-blue text-white px-3 py-1.5 rounded-full text-xs font-bold shadow-md">
              {t('about.founderTitle')}
            </span>
          </div>
          <img
            src="/founder.webp"
            alt={t('about.founderAlt')}
            class="w-full h-[400px] object-cover group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
            decoding="async"
            width="600"
            height="400"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-brand-blue/90 via-brand-blue/50 to-transparent p-6">
            <p class="text-white font-bold text-xl mb-0.5">Raju Gurung</p>
            <p class="text-white text-sm font-medium mb-3">{t('about.founderYears')}</p>
            <a
              href={t('about.rotaryLink')}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-white/20 backdrop-blur-sm rounded-full px-3 py-1 hover:bg-white/30 transition-all duration-300 group/rotary"
              aria-label={t('about.rotaryAriaLabel')}
            >
              <svg class="w-3.5 h-3.5 text-amber-300 group-hover/rotary:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"></path>
              </svg>
              <span class="text-white/90 text-xs font-medium group-hover/rotary:text-white transition-colors">
                {t('about.rotaryMember')}
              </span>
              <svg class="w-3.5 h-3.5 text-white/60 group-hover/rotary:text-white/90 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
              </svg>
            </a>
          </div>
        </div>
        <div class="p-5">
          <p class="text-stone-600 text-md leading-relaxed">
            {lang === 'zh-tw'
              ? '在尼泊爾旅遊業深耕逾 20 年，以在地深度服務為核心，帶領旅客真正走進尼泊爾。同時也是扶輪社的活躍會員，長期致力回饋在地社區。'
              : 'With over 20 years in Nepal\'s tourism industry, Raju founded Oriental Express Travel to deliver authentic, locally grounded journeys. He is also an active Rotary Club member, committed to giving back to the community.'}
          </p>
        </div>
      </div>

      <!-- Yathartha -->
      <div class="director-image-container group bg-white rounded-lg overflow-hidden shadow-md border border-stone-100 hover:shadow-xl transition-shadow duration-300">
        <div class="relative overflow-hidden">
          <div class="absolute top-4 left-4 z-10">
            <span class="bg-brand-blue text-white px-3 py-1.5 rounded-full text-xs font-bold shadow-md">
              {lang === 'zh-tw' ? '國際關係總監' : 'Director of International Relations'}
            </span>
          </div>
          <Image
            src={director}
            alt={lang === 'zh-tw' ? '國際關係總監 Yathartha Gurung' : 'Director of International Relations Yathartha Gurung'}
            class="w-full h-[400px] object-cover group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
            width={600}
            height={400}
            quality={85}
          />
          <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-brand-blue/90 via-brand-blue/50 to-transparent p-6">
            <p class="text-white font-bold text-xl mb-0.5">Yathartha Gurung</p>
            <p class="text-white text-sm font-medium">
              {lang === 'zh-tw' ? '澳洲餐旅與活動管理學士' : 'BA Hospitality & Events Management, Australia'}
            </p>
          </div>
        </div>
        <div class="p-5">
          <p class="text-stone-600 text-md leading-relaxed">
            {lang === 'zh-tw'
              ? '擁有澳洲餐旅與活動管理學士學位，並在澳洲餐旅業積累多年豐富經驗。現負責 Oriental Express Travel 的全球夥伴關係與國際客戶服務，將世界級的服務標準融入每段旅程。'
              : 'Holding a BA in Hospitality & Events Management from Australia and years of experience in the Australian hospitality sector, Yathartha leads global partnerships and international client engagement at Oriental Express Travel, bringing world-class service standards to every journey.'}
          </p>
        </div>
      </div>
    </div>

    <!-- Customization services -->
    <div class="customization-section bg-gradient-to-br from-amber-50 to-stone-100 rounded-lg p-8 md:p-12">
      <div class="text-center mb-8">
        <h3 class="text-2xl md:text-3xl font-bold text-stone-900 mb-4">
          {t('about.customization.title')}
        </h3>
        <p class="text-lg text-stone-700 max-w-3xl mx-auto">
          {t('about.customization.subtitle')}
        </p>
      </div>

      <!-- Service items -->
      <div class="grid md:grid-cols-3 gap-6">
        <div class="customization-card bg-white/80 backdrop-blur-sm rounded-lg p-6 transition-shadow">
          <div class="w-12 h-12 bg-amber-100 rounded-full flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
          </div>
          <h4 class="font-bold text-stone-900 mb-2">{t('about.customization.item1.title')}</h4>
          <p class="text-stone-600 text-sm">{t('about.customization.item1.desc')}</p>
        </div>

        <div class="customization-card bg-white/80 backdrop-blur-sm rounded-lg p-6 transition-shadow">
          <div class="w-12 h-12 bg-amber-100 rounded-full flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
            </svg>
          </div>
          <h4 class="font-bold text-stone-900 mb-2">{t('about.customization.item2.title')}</h4>
          <p class="text-stone-600 text-sm">{t('about.customization.item2.desc')}</p>
        </div>

        <div class="customization-card bg-white/80 backdrop-blur-sm rounded-lg p-6 transition-shadow">
          <div class="w-12 h-12 bg-amber-100 rounded-full flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
            </svg>
          </div>
          <h4 class="font-bold text-stone-900 mb-2">{t('about.customization.item3.title')}</h4>
          <p class="text-stone-600 text-sm">{t('about.customization.item3.desc')}</p>
        </div>
      </div>

      <!-- Real Tour & Transport Gallery -->
      <div class="mt-16 pt-12 border-t border-stone-200">
        <div class="text-center mb-10">
          <h4 class="text-2xl font-bold text-stone-900 mb-3">
            {lang === 'zh-tw' ? '舒適的專車接送與團體服務' : 'Comfortable Private Transport & Group Services'}
          </h4>
          <p class="text-stone-600 max-w-2xl mx-auto leading-relaxed">
            {lang === 'zh-tw'
              ? '我們會依照您的人數與行程需求，安排最適合的交通方式，讓您每一段旅途都安全、舒適。'
              : "We'll sort out the best transport for your group size and plans, so every part of your trip feels safe and comfortable."}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
          <!-- Solo / Flexible transport -->
          <div class="transport-card group rounded-lg overflow-hidden shadow-md bg-white hover:shadow-xl transition-shadow duration-300">
            <div class="relative overflow-hidden aspect-[16/10]">
              <Image
                src={soloTravelBus}
                alt={lang === 'zh-tw' ? '協助散客搭乘公車或 SUV' : 'Assisting solo travellers with bus or SUV transport'}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                quality={80}
              />
            </div>
            <div class="p-5">
              <h5 class="font-bold text-brand-blue text-lg mb-2">
                {lang === 'zh-tw' ? '散客與彈性旅客的交通安排' : 'Transport for Solo & Flexible Travellers'}
              </h5>
              <p class="text-stone-600 text-sm leading-relaxed">
                {lang === 'zh-tw'
                  ? '獨旅或行程較彈性的旅客，我們可以幫您安排SUV，並且視需求協助處理長途巴士票或飛機票購票等相關事宜以銜接行程，讓您不必煩惱交通問題。'
                  : 'For solo or flexible travellers, we can arrange private transport and assist with any additional travel arrangements, such as bus or flight tickets, giving you the freedom to explore Nepal your way.'}
              </p>
            </div>
          </div>

           <!-- Private SUV -->
          <div class="transport-card group rounded-lg overflow-hidden shadow-md bg-white hover:shadow-xl transition-shadow duration-300">
            <div class="relative overflow-hidden aspect-[16/10]">
              <Image
                src={privateSuvJomsom}
                alt={lang === 'zh-tw' ? '旅客在 Jomsom 搭乘私人 SUV' : 'Travellers on private SUV in Jomsom'}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                quality={80}
              />
            </div>
            <div class="p-5">
              <h5 class="font-bold text-brand-blue text-lg mb-2">
                {lang === 'zh-tw' ? '小團體專屬 SUV' : 'Private SUV for Families & Small Groups'}
              </h5>
              <p class="text-stone-600 text-sm leading-relaxed">
                {lang === 'zh-tw'
                  ? '對於 1 至 6 人的小型旅遊團體，我們提供舒適的私人 SUV 接送服務。我們很開心Jomsom沿途壯麗的風景讓我們的旅客留下難忘的回憶 :)'
                  : 'Perfect for small groups of 1 to 6, we\'ll take care of transfers in a comfortable private SUV. We\'re so glad that the stunning scenery on the way to Jomsom left our guests with memories they\'ll carry with them forever. :)'}
              </p>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Group bus -->
          <div class="transport-card group rounded-lg overflow-hidden shadow-md bg-white hover:shadow-xl transition-shadow duration-300">
            <div class="relative overflow-hidden aspect-[4/3]">
              <Image
                src={busGroup}
                alt={lang === 'zh-tw' ? '大型旅遊團體與旅遊巴士' : 'Large tour group with tourist bus'}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                quality={80}
              />
            </div>
            <div class="p-5">
              <h5 class="font-bold text-brand-blue text-lg mb-2">
                {lang === 'zh-tw' ? '團體包車服務' : 'Bus Service for Large Groups'}
              </h5>
              <p class="text-stone-600 text-sm leading-relaxed">
                {lang === 'zh-tw'
                  ? '若您的旅遊團體人數較多，我們也有旅遊巴士可一次接送整個團隊，省去個別安排交通的繁瑣，讓大型旅遊行程更加順暢。'
                  : 'For larger tour groups, we provide a dedicated tourist bus to transfer your entire team at once, keeping your group trip running smoothly.'}
              </p>
            </div>
          </div>

          <!-- Bus exterior -->
          <div class="hidden transport-card group rounded-lg overflow-hidden shadow-md bg-white hover:shadow-xl transition-shadow duration-300">
            <div class="relative overflow-hidden aspect-[4/3]">
              <Image
                src={busExterior}
                alt={lang === 'zh-tw' ? '現代化旅遊巴士外觀' : 'Modern tourist bus exterior'}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                quality={80}
              />
            </div>
          </div>

          <!-- Bus interior -->
          <div class="transport-card group rounded-lg overflow-hidden shadow-md bg-white hover:shadow-xl transition-shadow duration-300">
            <div class="relative overflow-hidden aspect-[4/3]">
              <Image
                src={busInterior}
                alt={lang === 'zh-tw' ? '旅遊巴士寬敞冷氣座艙' : 'Spacious air-conditioned bus interior'}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                quality={80}
              />
            </div>
            <div class="p-5">
              <h5 class="font-bold text-brand-blue text-lg mb-2">
                {lang === 'zh-tw' ? '舒適乘車體驗' : 'Comfortable Travel Experience'}
              </h5>
              <p class="text-stone-600 text-sm leading-relaxed">
                {lang === 'zh-tw'
                  ? '車廂內設有寬敞、整潔的座位並配備冷氣。無論旅途多遠，您都能在舒適的環境中放鬆，同時欣賞窗外的尼泊爾美景。'
                  : 'Our cabins offer wide, clean seats with full air-conditioning throughout. No matter the distance, you can relax in cool, comfortable surroundings and enjoy the scenery rolling past your window.'}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const common = { ease: 'power3.out' as const, once: true as const };

  // Section title
  gsap.from('.about-section-title', {
    opacity: 0, y: 32, duration: 0.8,
    scrollTrigger: { trigger: '#aboutUs', start: 'top 78%', once: true },
  });

  // Text block — fade up
  gsap.from('.about-text-block', {
    opacity: 0, y: 32, duration: 0.9,
    ease: 'power3.out',
    scrollTrigger: { trigger: '#aboutUs', start: 'top 70%', once: true },
  });

  // Portrait cards — staggered slide up
  gsap.from('.founder-image-container, .director-image-container', {
    opacity: 0, y: 48, duration: 0.9,
    stagger: 0.15,
    ease: 'power3.out',
    scrollTrigger: { trigger: '.founder-image-container', start: 'top 80%', once: true },
  });

  // Customization cards — staggered rise
  gsap.from('.customization-card', {
    opacity: 0, y: 44, duration: 0.65,
    stagger: 0.1,
    ease: 'power3.out',
    scrollTrigger: { trigger: '.customization-section', start: 'top 80%', once: true },
  });

  // Transport cards — staggered rise
  gsap.from('.transport-card', {
    opacity: 0, y: 40, duration: 0.6,
    stagger: 0.1,
    ease: 'power3.out',
    scrollTrigger: { trigger: '.transport-card', start: 'top 85%', once: true },
  });
</script>

<!-- Person Schema (JSON-LD) — Raju Gurung -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Raju Gurung",
  "jobTitle": "Founder & CEO",
  "worksFor": {
    "@type": "TravelAgency",
    "name": "Oriental Express Travel P. Ltd.",
    "url": "https://oriental-express-travel.com"
  },
  "memberOf": {
    "@type": "Organization",
    "name": "Rotary Club of Himalayan Gurkhas",
    "url": "https://rchimalayangurkhas.org.np/"
  },
  "description": "Founder and CEO of Oriental Express Travel with over 20 years of experience in Nepal's tourism industry.",
  "knowsAbout": ["Nepal Trekking", "Himalayan Tourism", "Nepal Culture", "Adventure Travel", "Everest Base Camp", "Annapurna"]
})} />

<!-- Person Schema (JSON-LD) — Yathartha Gurung -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Yathartha Gurung",
  "jobTitle": "Director of International Relations",
  "worksFor": {
    "@type": "TravelAgency",
    "name": "Oriental Express Travel P. Ltd.",
    "url": "https://oriental-express-travel.com"
  },
  "description": "Director of International Relations at Oriental Express Travel, leading global partnerships and international client engagement with hospitality expertise from Australia.",
  "knowsAbout": ["International Tourism", "Hospitality Management", "Nepal Travel", "Client Relations"]
})} />