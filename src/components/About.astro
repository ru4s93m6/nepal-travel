---
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: 'zh-tw' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="aboutUs" class="py-20 px-6 bg-stone-50">
  <div class="max-w-6xl mx-auto">
    <!-- Section title -->
    <h2 class="text-4xl md:text-5xl font-bold mb-6 text-center text-stone-800">
      {t('about.title')}
    </h2>

    <!-- Main Content -->
    <div class="grid md:grid-cols-2 gap-12 items-center mb-16">
      <div class="relative md:order-2">
        <!-- 標籤 -->
        <div class="absolute -top-3 left-6 z-10">
          <span class="bg-amber-500 text-white px-4 py-2 rounded-full text-sm font-medium shadow-lg">
            {t('about.founderLabel')}
          </span>
        </div>
        
        <div class="relative rounded-lg overflow-hidden shadow-xl border-4 border-white">
          <img 
            src="/founder.webp" 
            alt={t('about.founderAlt')}
            class="w-full h-[400px] md:h-[500px] object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            width="600"
            height="500"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/90 via-black/60 to-transparent p-6">
            <p class="text-white font-bold text-xl mb-1">Raju Gurung</p>
            <p class="text-amber-300 text-sm font-medium mb-2">{t('about.founderTitle')}</p>
            <p class="text-white/90 text-sm">{t('about.founderYears')}</p>

            <!-- Rotary Club Member -->
            <div class="flex items-center gap-2 mt-3">
              <a 
                href={t('about.rotaryLink')}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2 bg-white/20 backdrop-blur-sm rounded-full px-3 py-1 hover:bg-white/30 transition-all duration-300 group"
                aria-label={t('about.rotaryAriaLabel')}
              >
                <svg class="w-4 h-4 text-amber-300 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"></path>
                </svg>
                <span class="text-white/90 text-xs font-medium group-hover:text-white transition-colors">
                  {t('about.rotaryMember')}
                </span>
                <!-- External Link Icon -->
                <svg class="w-4 h-4 text-white/60 group-hover:text-white/90 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="space-y-6 md:order-1">
        <h3 class="text-3xl font-bold text-stone-900 leading-tight">
          {t('about.subtitle')}
        </h3>
        
        <p class="text-lg text-stone-700 leading-relaxed">
          {t('about.intro')}
        </p>

        <p class="text-lg text-stone-700 leading-relaxed">
          {t('about.experience')}
        </p>

        <p class="text-lg text-stone-700 leading-relaxed">
          {t('about.experience1')}
        </p>

        <!-- Main features -->
        <div class="space-y-4 pt-4">
          <div class="flex items-start gap-3">
            <svg class="w-6 h-6 text-amber-600 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <div>
              <h4 class="font-semibold text-stone-900">{t('about.feature1.title')}</h4>
              <p class="text-stone-600">{t('about.feature1.desc')}</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <svg class="w-6 h-6 text-amber-600 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <div>
              <h4 class="font-semibold text-stone-900">{t('about.feature2.title')}</h4>
              <p class="text-stone-600">{t('about.feature2.desc')}</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <svg class="w-6 h-6 text-amber-600 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <div>
              <h4 class="font-semibold text-stone-900">{t('about.feature3.title')}</h4>
              <p class="text-stone-600">{t('about.feature3.desc')}</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Customization services -->
    <div class="bg-gradient-to-br from-amber-50 to-stone-100 rounded-lg p-8 md:p-12">
      <div class="text-center mb-8">
        <h3 class="text-2xl md:text-3xl font-bold text-stone-900 mb-4">
          {t('about.customization.title')}
        </h3>
        <p class="text-lg text-stone-700 max-w-3xl mx-auto">
          {t('about.customization.subtitle')}
        </p>
      </div>

      <!-- Service items -->
      <div class="grid md:grid-cols-3 gap-6">
        <div class="bg-white/80 backdrop-blur-sm rounded-lg p-6  transition-shadow">
          <div class="w-12 h-12 bg-amber-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
          </div>
          <h4 class="font-bold text-stone-900 mb-2">{t('about.customization.item1.title')}</h4>
          <p class="text-stone-600 text-sm">{t('about.customization.item1.desc')}</p>
        </div>

        <div class="bg-white/80 backdrop-blur-sm rounded-lg p-6  transition-shadow">
          <div class="w-12 h-12 bg-amber-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
            </svg>
          </div>
          <h4 class="font-bold text-stone-900 mb-2">{t('about.customization.item2.title')}</h4>
          <p class="text-stone-600 text-sm">{t('about.customization.item2.desc')}</p>
        </div>

        <div class="bg-white/80 backdrop-blur-sm rounded-lg p-6  transition-shadow">
          <div class="w-12 h-12 bg-amber-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
            </svg>
          </div>
          <h4 class="font-bold text-stone-900 mb-2">{t('about.customization.item3.title')}</h4>
          <p class="text-stone-600 text-sm">{t('about.customization.item3.desc')}</p>
        </div>
      </div>
    </div>
  </div>
</section>